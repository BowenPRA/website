{% set T = strings[lang] %}
{% set u = (page.url or "/") | basePath %}
{% set inAcademics = u.startsWith("/learning/") %}
{% set inAdmissions = u.startsWith("/admissions/") or u.startsWith("/families/") or u.startsWith("/contact/") %}
<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href="{{ '/' | href(lang) }}" aria-label="{{ T.homeLabel }}">
      <img class="brand__logo" src="{{ '/assets/img/logo.png' | href(lang) }}" alt="" width="1064" height="429">
    </a>

    <nav class="nav-desktop" aria-label="{{ T.mainNav }}">
      <ul>
        <li><a href="{{ '/about/' | href(lang) }}"{% if u.startsWith('/about/') %} aria-current="page"{% endif %}>{{ T.about }}</a></li>
        <li class="has-menu">
          <a href="{{ '/learning/' | href(lang) }}"{% if inAcademics %} aria-current="{{ 'page' if u == '/learning/' else 'true' }}"{% endif %}>{{ T.academics }} <svg class="caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <ul class="menu">
            <li><a class="dot dot--sun" href="{{ '/learning/early-years/' | href(lang) }}">{{ T.stages.early }} <small>{{ T.stages.earlySub }}</small></a></li>
            <li><a class="dot dot--green" href="{{ '/learning/primary/' | href(lang) }}">{{ T.stages.primary }} <small>{{ T.stages.primarySub }}</small></a></li>
            <li><a class="dot dot--blue" href="{{ '/learning/lower-secondary/' | href(lang) }}">{{ T.stages.lower }} <small>{{ T.stages.lowerSub }}</small></a></li>
            <li><a class="dot dot--coral" href="{{ '/learning/upper-secondary/' | href(lang) }}">{{ T.stages.upper }} <small>{{ T.stages.upperSub }}</small></a></li>
            <li><a class="dot dot--violet" href="{{ '/learning/global-program/' | href(lang) }}">{{ T.stages.global }} <small>{{ T.stages.globalSub }}</small></a></li>
          </ul>
        </li>
        <li class="has-menu">
          <a href="{{ '/admissions/' | href(lang) }}"{% if inAdmissions %} aria-current="{{ 'page' if u == '/admissions/' else 'true' }}"{% endif %}>{{ T.admissions }} <svg class="caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <ul class="menu">
            <li><a href="{{ '/admissions/' | href(lang) }}">{{ T.enrollment }}</a></li>
            <li><a href="{{ '/admissions/tuition-and-fees/' | href(lang) }}">{{ T.fees }}</a></li>
            <li><a href="{{ '/families/schedule/' | href(lang) }}">{{ T.schedule }}</a></li>
            <li><a href="{{ '/families/handbook/' | href(lang) }}">{{ T.handbook }}</a></li>
            <li><a href="{{ '/contact/' | href(lang) }}">{{ T.tour }}</a></li>
          </ul>
        </li>
        <li><a href="{{ '/events/' | href(lang) }}"{% if u.startsWith('/events/') %} aria-current="page"{% endif %}>{{ T.events }}</a></li>
        <li><a href="{{ '/writing/' | href(lang) }}"{% if u.startsWith('/writing/') %} aria-current="{{ 'page' if u == '/writing/' else 'true' }}"{% endif %}>{{ T.writing }}</a></li>
      </ul>
      <a class="btn btn--green btn--small" href="{{ '/contact/' | href(lang) }}">{{ T.contact }}</a>
    </nav>

    {# Language toggle: the same page in the other language. Pages with no twin (the album) set noTwin. #}
    {% if not noTwin %}
    <div class="lang-toggle" role="group" aria-label="{{ T.lang.label }}">
      {% for code in ["en", "vi"] %}
      {% set L = strings[code] %}
      {% if code == lang %}<span lang="{{ code }}" aria-current="true"><abbr title="{{ L.name }}">{{ code | upper }}</abbr></span>
      {% else %}<a href="{{ page.url | twin | href(code) }}" lang="{{ code }}" hreflang="{{ code }}" title="{{ T.lang.switchTo }}"><span aria-hidden="true">{{ code | upper }}</span><span class="u-hide">{{ L.name }}</span></a>{% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="sheet">
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="menu-toggle__label">{{ T.menu }}</span>
    </button>
  </div>

  {# The announcement reel, under the nav bar on every page (src/_data/reel.json; `reelNow` is set in
     layouts/base.njk). One item shows at a time and main.js turns them over when there are several.
     The script straight after it drops any item whose hideFrom date has come since the site was built,
     before the page is drawn. #}
  {% if reelNow.length %}
  <div class="wrap reel" role="region" aria-label="{{ T.reel.region }}">
    <p class="reel__label"><span class="reel__dot" aria-hidden="true"></span><span class="reel__word">{{ T.reel.label }}</span></p>
    <ul class="reel__items">
      {% for r in reelNow %}
      <li class="reel__item"{% if r.hideFrom %} data-hide-from="{{ r.hideFrom }}"{% endif %}{% if not loop.first %} hidden{% endif %}>
        {% if r.url %}<a href="{{ r.url | href(lang) }}"><span class="reel__text">{{ r.text }}</span>{% if r.link %}<span class="reel__more">{{ r.link }}</span>{% endif %}</a>
        {% else %}<span class="reel__text">{{ r.text }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% if reelNow.length > 1 %}
    <p class="reel__dots">{% for r in reelNow %}<button type="button" aria-label="{{ T.reel.show }} {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}</p>
    {% endif %}
  </div>
  <script>
    (function () {
      var reel = document.currentScript.previousElementSibling;
      var today = new Date(Date.now() + 7 * 3600e3).toISOString().slice(0, 10);
      var items = reel.querySelectorAll(".reel__item"), dots = reel.querySelectorAll(".reel__dots button");
      for (var i = 0; i < items.length; i++) {
        var until = items[i].getAttribute("data-hide-from");
        if (until && until <= today) { items[i].remove(); if (dots[i]) dots[i].remove(); }
      }
      var left = reel.querySelectorAll(".reel__item");
      if (!left.length) { reel.remove(); document.body.classList.remove("has-reel"); return; }
      left[0].hidden = false;
      var dotRow = reel.querySelector(".reel__dots");
      if (dotRow && left.length < 2) dotRow.remove();
    })();
  </script>
  {% endif %}
</header>

<nav class="sheet" id="sheet" aria-label="{{ T.mobileNav }}" hidden>
  <div class="sheet__group">
    <a class="sheet__top" href="{{ '/' | href(lang) }}"{% if u == '/' %} aria-current="page"{% endif %}>{{ T.home }}</a>
    <a class="sheet__top" href="{{ '/about/' | href(lang) }}"{% if u.startsWith('/about/') %} aria-current="page"{% endif %}>{{ T.about }}</a>
    <a class="sheet__top" href="{{ '/events/' | href(lang) }}"{% if u.startsWith('/events/') %} aria-current="page"{% endif %}>{{ T.events }}</a>
    <a class="sheet__top" href="{{ '/writing/' | href(lang) }}"{% if u.startsWith('/writing/') %} aria-current="page"{% endif %}>{{ T.writing }}</a>
  </div>
  <div class="sheet__group">
    <a class="sheet__label" href="{{ '/learning/' | href(lang) }}">{{ T.academics }}</a>
    <a class="dot dot--sun" href="{{ '/learning/early-years/' | href(lang) }}">{{ T.stages.early }} <small>{{ T.stages.earlySubShort }}</small></a>
    <a class="dot dot--green" href="{{ '/learning/primary/' | href(lang) }}">{{ T.stages.primary }} <small>{{ T.stages.primarySub }}</small></a>
    <a class="dot dot--blue" href="{{ '/learning/lower-secondary/' | href(lang) }}">{{ T.stages.lower }} <small>{{ T.stages.lowerSub }}</small></a>
    <a class="dot dot--coral" href="{{ '/learning/upper-secondary/' | href(lang) }}">{{ T.stages.upper }} <small>{{ T.stages.upperSub }}</small></a>
    <a class="dot dot--violet" href="{{ '/learning/global-program/' | href(lang) }}">{{ T.stages.global }} <small>{{ T.stages.globalSub }}</small></a>
  </div>
  <div class="sheet__group">
    <a class="sheet__label" href="{{ '/admissions/' | href(lang) }}">{{ T.admissions }}</a>
    <a href="{{ '/admissions/' | href(lang) }}">{{ T.enrollment }}</a>
    <a href="{{ '/admissions/tuition-and-fees/' | href(lang) }}">{{ T.fees }}</a>
    <a href="{{ '/families/schedule/' | href(lang) }}">{{ T.schedule }}</a>
    <a href="{{ '/families/handbook/' | href(lang) }}">{{ T.handbook }}</a>
  </div>
  <div class="sheet__group sheet__group--cta">
    <a class="btn btn--green" href="{{ '/contact/' | href(lang) }}">{{ T.contact }}</a>
    <a class="sheet__phone" href="tel:{{ site.phoneIntl }}">{{ T.call }} {{ site.phone }}</a>
  </div>
  <div class="tape" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
</nav>
