{# One issue of a weekly newsletter, the same for /newsletter/<slug>/ and /vi/newsletter/<slug>/.
   Needs `issue` (a public payload, version 1: admin repo src/lib/newsletter/README.md) and `lang`.
   Every part has id="s-<part id>": the email's "Read more" links land on it. #}
{% import "macros/nl.njk" as m %}
{% set T = strings[lang] %}{% set W = T.nl %}
{% set ed = issue.edition %}
{% set dates = issue.need.dates if (issue.need and issue.need.dates) else [] %}
{% set reminders = (issue.need.reminders if issue.need else []) | nlWithText %}
{% set hasNeed = dates.length or reminders.length %}
{% set hasClosing = issue.parts | nlHasPart("closing") %}
{% set otherLang = "vi" if lang == "en" else "en" %}

{# ---------- nameplate, cover and opening ---------- #}
<section class="nlhead nlhead--{{ ed }}">
  <span class="nlhead__dots" aria-hidden="true"></span>
  {% if ed == "ey" %}
  <svg class="nlhead__sun" viewBox="0 0 200 200" aria-hidden="true"><g class="nlhead__rays">{% for i in range(0, 12) %}<rect x="95" y="4" width="10" height="38" rx="5" transform="rotate({{ i * 30 }} 100 100)"/>{% endfor %}</g><circle cx="100" cy="100" r="44"/></svg>
  {% else %}
  {% set frondClass = "frond--tr frond--soft" %}{% include "partials/frond.njk" %}
  {% endif %}
  <div class="wrap">
    <nav class="nl-crumbs" aria-label="{{ T.newsletter }}"><a href="{{ '/newsletter/' | href(lang) }}">{{ T.newsletter }}</a>{{ "chevron-right" | ico | safe }}<span>{{ W.editions[ed] }}</span></nav>
    <header class="nameplate rise" style="--d:0">
      <p class="nameplate__kicker"><span class="nameplate__mark" aria-hidden="true"></span>{{ site.name }} · Hội An<span class="nameplate__mark nameplate__mark--r" aria-hidden="true"></span></p>
      <h1 class="nameplate__title">{{ issue.edition_name | nl(lang) }}</h1>
      <p class="nameplate__line"><span>{{ issue.label | nl(lang) }}</span><span><time datetime="{{ issue.date }}">{{ issue.day | nl(lang) }}</time></span>{% if issue.reading_minutes %}<span>{{ W.minRead | fill({ n: issue.reading_minutes }) }}</span>{% endif %}</p>
    </header>

    <div class="nlhead__grid{% if not issue.cover %} nlhead__grid--solo{% endif %}">
      {% if issue.cover %}
      <figure class="nl-cover rise" style="--d:1">
        <div class="leaf-wrap"><div class="photo photo--lg nl-cover__photo{% if issue.cover.h > issue.cover.w %} photo--tall{% endif %}">{{ m.img(issue.cover, lang, "(min-width: 1240px) 540px, (min-width: 900px) 44vw, (min-width: 620px) 560px, 92vw", true) }}</div></div>
        {% if issue.cover.alt | nl(lang) %}<figcaption>{{ issue.cover.alt | nl(lang) }}</figcaption>{% endif %}
      </figure>
      {% endif %}
      <div class="nl-opening rise" style="--d:2">
        <p class="nl-lead">{{ m.text(issue.opening.lead, lang, T) }}</p>
        {{ m.body(issue.opening.body, lang, T) }}
        <div class="nl-actions">
          {% if issue.pdf and issue.pdf.en %}<a class="btn btn--small nl-btn" href="{{ issue.pdf.en | nlUrl }}" target="_blank" rel="noopener">{{ "download" | ico | safe }}{{ W.pdfEn }}</a>{% endif %}
          {% if issue.pdf and issue.pdf.vi %}<a class="btn btn--small nl-btn nl-btn--line" href="{{ issue.pdf.vi | nlUrl }}" target="_blank" rel="noopener">{{ "download" | ico | safe }}{{ W.pdfVi }}</a>{% endif %}
          <a class="nl-otherlang" href="{{ page.url | twin | href(otherLang) }}" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{{ "languages" | ico | safe }}{{ T.lang.switchTo }}</a>
        </div>
      </div>
    </div>
  </div>
  {% include "partials/river.njk" %}
</section>

{# ---------- the issue ---------- #}
<section class="nlbody nlbody--{{ ed }}">
  <div class="wrap nlbody__grid">
    <nav class="nl-toc" aria-labelledby="nl-toc-h">
      <p class="nl-toc__h" id="nl-toc-h">{{ W.inIssue }}</p>
      <ul>
        {% if hasNeed %}<li><a href="#s-need">{{ "bell" | ico | safe }}<span>{{ W.needToKnow }}</span></a></li>{% endif %}
        {% for part in issue.parts %}
        {% if part.type == "class" %}
        <li class="nl-t--{{ part.tone }}"><a href="#s-{{ part.id }}"><span class="nl-toc__dot" aria-hidden="true"></span><span>{{ part.class }}</span></a></li>
        {% elif part.type == "story" or part.type == "photos" %}
        <li class="nl-t--{{ part.tone }}"><a href="#s-{{ part.id }}">{{ part.icon | ico | safe }}<span>{{ part.heading | nl(lang) }}</span></a></li>
        {% elif part.type == "quote" %}
        <li class="nl-t--green"><a href="#s-{{ part.id }}">{{ "quote" | ico | safe }}<span>{{ part.who | nl(lang) }}</span></a></li>
        {% elif part.type == "press" %}
        <li class="nl-t--violet"><a href="#s-{{ part.id }}">{{ "pen-line" | ico | safe }}<span>{{ W.pressFrom }}</span></a></li>
        {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="nl-main">
      {% if hasNeed %}
      <section class="nl-part nl-need" id="s-need" aria-labelledby="nl-need-h">
        <h2 class="nl-need__h" id="nl-need-h">{{ "bell" | ico | safe }}{{ W.needToKnow }}</h2>
        <div class="nl-need__grid{% if not (dates.length and reminders.length) %} nl-need__grid--one{% endif %}">
          {% if dates.length %}
          <div class="nl-dates">
            <h3>{{ "calendar-days" | ico | safe }}{{ W.dates }}</h3>
            <ul>
              {% for d in dates %}{% set leaf = d | nlLeaf(lang) %}
              <li class="nl-date{% if d.tag %} nl-date--{{ d.tag }}{% endif %}">
                {% if leaf %}<span class="nl-leaf" aria-hidden="true"><span class="nl-leaf__m">{{ leaf.month }}</span><span class="nl-leaf__d{% if '–' in leaf.day %} nl-leaf__d--range{% endif %}">{{ leaf.day }}{% if leaf.more %}<i>+</i>{% endif %}</span></span>{% else %}<span class="nl-leaf nl-leaf--none" aria-hidden="true">{{ "calendar-days" | ico | safe }}</span>{% endif %}
                <div class="nl-date__body">
                  <p class="nl-date__what">{{ m.text(d.what, lang, T) }}{% if d.tag and W[d.tag] %} <span class="nl-tag nl-tag--{{ d.tag }}">{{ W[d.tag] }}</span>{% endif %}</p>
                  <p class="nl-date__when"><span class="nl-pill">{{ d.date | nl(lang) }}</span>{% if d.time and (d.time | nl(lang)) %}<span class="nl-date__time">{{ "clock" | ico | safe }}{{ d.time | nl(lang) }}</span>{% endif %}</p>
                  {% if d.gcal %}<a class="nl-gcal" href="{{ d.gcal | nlUrl }}" target="_blank" rel="noopener">{{ "calendar-plus" | ico | safe }}{{ W.addToCalendar }}<span class="u-hide">: {{ d.what | nl(lang) }}</span></a>{% endif %}
                </div>
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
          {% if reminders.length %}
          <div class="nl-rem">
            <h3>{{ "pin" | ico | safe }}{{ W.reminders }}</h3>
            <ul>
              {% for r in reminders %}<li>{{ "check" | ico | safe }}<span>{{ m.text(r, lang, T) }}</span></li>{% endfor %}
            </ul>
          </div>
          {% endif %}
        </div>
      </section>
      {% endif %}

      {% for part in issue.parts %}
      {% if part.type == "story" %}
      {% set n = part.photos.length if part.photos else 0 %}
      <section class="nl-part nl-story nl-t--{{ part.tone }}" id="s-{{ part.id }}">
        <header class="nl-head">
          <span class="nl-badge">{{ part.icon | ico | safe }}</span>
          <h2>{{ m.text(part.heading, lang, T) }}</h2>
        </header>
        {% if part.when and (part.when | nl(lang)) %}<p class="nl-when">{{ "clock" | ico | safe }}{{ m.text(part.when, lang, T) }}</p>{% endif %}
        <div class="nl-story__cols{% if n == 1 %} nl-story__cols--side{% endif %}">
          <div>
            {{ m.body(part.body, lang, T) }}
            {% if part.button and part.button.url %}{% set onSite = part.button.url | nlOnSite %}
            <p class="nl-btnrow"><a class="btn btn--small nl-btn" href="{{ part.button.url | nlUrl | nlLink(lang) }}"{% if not onSite %} target="_blank" rel="noopener"{% endif %}>{{ m.text(part.button.label, lang, T) }}{{ "arrow-right" | ico | safe }}</a></p>
            {% endif %}
          </div>
          {% if n == 1 %}<div class="nl-gallery nl-side">{{ m.fig(part.photos[0], lang, "(min-width: 1040px) 330px, (min-width: 720px) 40vw, 92vw", "own") }}</div>{% endif %}
        </div>
        {% if n > 1 %}
        <div class="nl-gallery nl-row nl-row--{{ n }}">
          {% for p in part.photos %}{{ m.fig(p, lang, "(min-width: 1040px) 260px, (min-width: 720px) 30vw, 46vw") }}{% endfor %}
        </div>
        {% endif %}
      </section>

      {% elif part.type == "class" %}
      {% set n = part.photos.length if part.photos else 0 %}
      <section class="nl-part nl-class nl-t--{{ part.tone }}" id="s-{{ part.id }}">
        <header class="nl-class__band">
          {% if part.teacher and part.teacher.photo %}<span class="nl-class__face"><img src="{{ part.teacher.photo | nlUrl }}" alt="" width="120" height="138" loading="lazy" decoding="async"></span>
          {% else %}<span class="nl-class__face nl-class__face--none">{{ "users" | ico | safe }}</span>{% endif %}
          <div>
            <h2>{{ part.class }}</h2>
            {% if part.teacher and part.teacher.name %}<p class="nl-class__from">{{ W.fromTeacher | fill({ name: part.teacher.name }) }}</p>{% endif %}
          </div>
        </header>
        <div class="nl-class__inner">
          <div class="nl-story__cols{% if n == 1 %} nl-story__cols--side{% endif %}">
            {{ m.body(part.body, lang, T) }}
            {% if n == 1 %}<div class="nl-gallery nl-side">{{ m.fig(part.photos[0], lang, "(min-width: 1040px) 300px, (min-width: 720px) 38vw, 92vw", "own") }}</div>{% endif %}
          </div>
          {% if n > 1 %}
          <div class="nl-gallery nl-row nl-row--{{ n }}">
            {% for p in part.photos %}{{ m.fig(p, lang, "(min-width: 1040px) 260px, (min-width: 720px) 30vw, 46vw") }}{% endfor %}
          </div>
          {% endif %}
          {% if part.words and part.words.length %}
          <div class="nl-words">
            <h3>{{ "languages" | ico | safe }}{{ W.wordsOfWeek }}</h3>
            <ul>
              {% for w in part.words %}<li><b lang="en">{{ w.en }}</b>{% if w.vi %}<span lang="vi">{{ w.vi }}</span>{% endif %}</li>{% endfor %}
            </ul>
          </div>
          {% endif %}
          {% if part.ask and (part.ask | nl(lang)) %}
          <div class="nl-ask">
            <p class="nl-ask__label">{{ "message-circle" | ico | safe }}{{ W.askYourChild }}</p>
            <p class="nl-ask__q">{{ m.text(part.ask, lang, T) }}</p>
          </div>
          {% endif %}
        </div>
      </section>

      {% elif part.type == "photos" %}
      {% set n = part.photos.length if part.photos else 0 %}
      {% if n %}
      <section class="nl-part nl-photoset nl-t--{{ part.tone }}" id="s-{{ part.id }}">
        <header class="nl-head">
          <span class="nl-badge">{{ part.icon | ico | safe }}</span>
          <h2>{{ m.text(part.heading, lang, T) }}</h2>
        </header>
        <div class="collage collage--wide nl-prints nl-prints--{{ n if n < 4 else 'many' }}">
          {% for p in part.photos %}<div class="photo">{{ m.img(p, lang, "(min-width: 1040px) 250px, (min-width: 720px) 30vw, 44vw") }}</div>{% endfor %}
        </div>
      </section>
      {% endif %}

      {% elif part.type == "quote" %}
      <section class="nl-part nl-quote{% if part.photo %} nl-quote--photo{% endif %}" id="s-{{ part.id }}">
        <figure>
          {% if part.photo %}<div class="nl-gallery nl-quote__pic"><div class="photo">{{ m.img(part.photo, lang, "160px") }}</div></div>{% endif %}
          <div>
            <span class="nl-quote__mark" aria-hidden="true">“</span>
            <blockquote><p>{{ m.text(part.text, lang, T) }}</p></blockquote>
            <figcaption>{{ m.text(part.who, lang, T) }}</figcaption>
          </div>
        </figure>
      </section>

      {% elif part.type == "press" %}
      {% set onSite = part.url | nlOnSite %}
      <section class="nl-part" id="s-{{ part.id }}">
        <a class="nl-press" href="{{ part.url | nlUrl | nlLink(lang) }}"{% if not onSite %} target="_blank" rel="noopener"{% endif %}>
          <span class="nl-press__ico">{{ "pen-line" | ico | safe }}</span>
          <span class="nl-press__body">
            <span class="nl-press__kicker">{{ W.pressFrom }}</span>
            <h2 class="nl-press__title" lang="en">{{ part.title }}</h2>
            {% if part.author %}<span class="nl-press__by">{{ W.by | fill({ name: part.author }) }}</span>{% endif %}
            {% if part.blurb | nl(lang) %}<span class="nl-press__blurb">{{ m.text(part.blurb, lang, T) }}</span>{% endif %}
            <span class="nl-press__go">{{ W.readPost }}{{ "arrow-right" | ico | safe }}</span>
          </span>
        </a>
      </section>

      {% elif part.type == "closing" %}
      <section class="nl-part nl-closing" id="s-{{ part.id }}">
        {{ m.body(part.body, lang, T) }}
        <p class="nl-sign">{{ W.signoff }}<br><strong>{{ W.from }}</strong></p>
      </section>
      {% endif %}
      {% endfor %}

      {% if not hasClosing %}
      <section class="nl-part nl-closing"><p class="nl-sign">{{ W.signoff }}<br><strong>{{ W.from }}</strong></p></section>
      {% endif %}

      <div class="nl-end">
        {% if issue.pdf and issue.pdf.en %}<a class="btn btn--small nl-btn" href="{{ issue.pdf.en | nlUrl }}" target="_blank" rel="noopener">{{ "download" | ico | safe }}{{ W.pdfEn }}</a>{% endif %}
        {% if issue.pdf and issue.pdf.vi %}<a class="btn btn--small nl-btn nl-btn--line" href="{{ issue.pdf.vi | nlUrl }}" target="_blank" rel="noopener">{{ "download" | ico | safe }}{{ W.pdfVi }}</a>{% endif %}
        <a class="nl-end__all" href="{{ '/newsletter/' | href(lang) }}">{{ "newspaper" | ico | safe }}{{ W.allIssues }}</a>
      </div>
    </div>
  </div>
</section>

{# ---------- past issues of the same newsletter ---------- #}
{% set past = newsletters | nlPast(issue, 6) %}
{% if past.length %}
{% set waveColor = "pale-green" if ed == "ey" else "pale-blue" %}{% include "partials/wave.njk" %}
<section class="{{ 'band--pale-green' if ed == 'ey' else 'band--pale-blue' }} nl-past">
  <div class="wrap">
    <div class="nl-past__head">
      <h2>{{ W.pastIssues }}</h2>
      <a href="{{ '/newsletter/' | href(lang) }}">{{ W.allIssues }}{{ "arrow-right" | ico | safe }}</a>
    </div>
    <ul class="nl-cards">
      {% for card in past %}{% set cardH = "h3" %}{% include "partials/nl-card.njk" %}{% endfor %}
    </ul>
  </div>
</section>
{% set waveColor = "blue" %}{% include "partials/wave.njk" %}
{% else %}
{% set waveColor = "blue" %}{% include "partials/wave.njk" %}
{% endif %}

{# These pages are public, so the end is the usual invitation to visit. #}
{% set ctaTitle = "" %}{% set ctaText = "" %}
{% include "partials/cta.njk" %}

{# Reader count (README "Counting readers"): once per browser session per issue and language, this
   page tells The Current it was opened, in which language, where the reader came from (?from= in
   the address, our own site, or "direct") and the part they landed on. Nothing about the reader. #}
<script>
  (function () {
    var slug = {{ issue.slug | dump | safe }}, lang = {{ lang | dump | safe }};
    if (!/(^|\.)pra\.edu\.vn$/.test(location.hostname)) return; // only the live site counts
    var key = "nl-seen:" + slug + ":" + lang;
    try { if (sessionStorage.getItem(key)) return; sessionStorage.setItem(key, "1"); } catch (e) {}
    var from = "";
    try { from = new URLSearchParams(location.search).get("from") || ""; } catch (e) {}
    var source = ["email", "chat", "facebook", "site", "pdf"].indexOf(from) >= 0 ? from
      : /^https?:\/\/([a-z0-9-]+\.)*pra\.edu\.vn(\/|$)/i.test(document.referrer) ? "site" : "direct";
    var hash = location.hash.replace(/^#/, "");
    var anchor = /^s-[a-z0-9]{1,12}$/.test(hash) ? hash : "";
    var k = {{ site.forms.key | dump | safe }};
    try {
      fetch({{ (site.forms.base + "/rest/v1/rpc/adm_newsletter_seen") | dump | safe }}, {
        method: "POST", keepalive: true,
        headers: { apikey: k, Authorization: "Bearer " + k, "Content-Type": "application/json" },
        body: JSON.stringify({ p_slug: slug, p_lang: lang, p_source: source, p_anchor: anchor })
      }).catch(function () {});
    } catch (e) {}
  })();
</script>
