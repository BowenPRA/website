{# The noticeboard, under the hero on the home page. Items come from src/_data/announcements.json,
   a card each. Two of them have a flyer: the button carries a tilted thumbnail of it and opens it
   full size in the shared lightbox (main.js). Short headlines go in the reel under the nav bar
   (src/_data/reel.json), which replaced the scrolling strip that used to sit above these cards. #}
{% set T = strings[lang] %}
<section class="notices-band">
  <div class="wrap">
    <h2 class="u-hide">{{ T.notices.heading }}</h2>

    <ul class="notices">
      {% for a in announcements %}
      <li class="notice stage-{{ a.tone }}" id="{{ a.id }}">
        <p class="notice__kind">{{ a.kind }}</p>
        <h3>{{ a.title }}</h3>
        <p class="notice__when">{{ a.when }}</p>
        <p class="notice__text">{{ a.text }}</p>
        {% if a.note %}<p class="notice__note">{{ a.note }}</p>{% endif %}
        <p class="notice__do">
          {% if a.flyer %}
          <button class="notice__flyer" type="button">
            <span class="notice__poster" aria-hidden="true">{% photo a.flyer, "", "72px" %}</span>{{ T.notices.flyer }}
          </button>
          {% endif %}
          <a class="notice__link" href="{{ a.cta.url | href(lang) }}">{{ a.cta.label }}</a>
        </p>
      </li>
      {% endfor %}
    </ul>
    <p class="notices__hint">{{ T.notices.swipe }}</p>
  </div>
</section>
