{# The noticeboard, under the hero on the home page. Items come from src/_data/announcements.json.
   The strip scrolls the headlines; the cards carry the detail. Two of them have a flyer: the button
   carries a tilted thumbnail of it and opens it full size in the shared lightbox (main.js). #}
<section class="notices-band">
  <div class="wrap">
    <h2 class="u-hide">Announcements</h2>

    <div class="ticker">
      <p class="ticker__label"><span class="ticker__dot" aria-hidden="true"></span>Now on</p>
      <div class="ticker__window">
        <div class="ticker__track">
          {% for a in announcements %}<span class="ticker__item">{{ a.ticker }}</span>{% endfor %}
          {% for a in announcements %}<span class="ticker__item" aria-hidden="true">{{ a.ticker }}</span>{% endfor %}
        </div>
      </div>
    </div>

    <ul class="notices">
      {% for a in announcements %}
      <li class="notice stage-{{ a.tone }}" id="{{ a.id }}">
        <p class="notice__kind">{{ a.kind }}</p>
        <h3>{{ a.title }}</h3>
        <p class="notice__when">{{ a.when }}</p>
        <p class="notice__text">{{ a.text }}</p>
        {% if a.note %}<p class="notice__note">{{ a.note }}</p>{% endif %}
        <p class="notice__do">
          {% if a.flyer %}
          <button class="notice__flyer" type="button">
            <span class="notice__poster" aria-hidden="true">{% photo a.flyer, "", "72px" %}</span>See the flyer
          </button>
          {% endif %}
          <a class="notice__link" href="{{ a.cta.url | url }}">{{ a.cta.label }}</a>
        </p>
      </li>
      {% endfor %}
    </ul>
    <p class="notices__hint">Swipe for more.</p>
  </div>
</section>
