<section class="cta">
  <span class="cta__bubble cta__bubble--a" aria-hidden="true"></span>
  <span class="cta__bubble cta__bubble--b" aria-hidden="true"></span>
  <span class="cta__bubble cta__bubble--c" aria-hidden="true"></span>
  <img class="leaf leaf--tr" src="{{ '/assets/img/leaf-c.webp' | url }}" alt="" width="900" height="910" loading="lazy">
  <div class="wrap cta__inner">
    <h2>{{ ctaTitle or "Come and see it for yourself." }}</h2>
    <p>{{ ctaText or "The best way to know if PRA fits your child is to walk around for an hour. Tours run on school days. If you are not in Hội An yet, we will do a video call." }}</p>
    <div class="cta__actions">
      <a class="btn btn--sun" href="{{ '/contact/' | url }}">Book a tour</a>
      <a class="btn btn--ghost-white" href="tel:{{ site.phoneIntl }}">Call {{ site.phone }}</a>
    </div>
  </div>
</section>
