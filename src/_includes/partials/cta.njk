{% set T = strings[lang] %}
<section class="cta">
  {% set frondClass = "frond--bl" %}{% include "partials/frond.njk" %}
  {% set frondClass = "frond--tr" %}{% include "partials/frond.njk" %}
  <div class="wrap cta__inner">
    <h2>{{ ctaTitle or T.cta.title }}</h2>
    <p>{{ ctaText or T.cta.text }}</p>
    <div class="cta__actions">
      <a class="btn btn--white" href="{{ '/contact/' | href(lang) }}">{{ T.tour }}</a>
      <a class="btn btn--ghost-white" href="tel:{{ site.phoneIntl }}">{{ T.call }} {{ site.phone }}</a>
    </div>
  </div>
</section>
