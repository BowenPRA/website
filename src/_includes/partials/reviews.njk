{# What families say, in full: five-star Google reviews (src/_data/reviews.json) on the About page,
   with the listing's overall rating beside the heading. Each card leads with the review's `pull`
   line, then the whole review in smaller type with that line marked like a highlighter pen.
   Long reviews stop after a few lines with a "Read more" button (main.js); without JavaScript
   they show in full. Each review keeps its own language (lang); `reviewsFor` puts the page's
   language first. Columns on wide screens, a swipe strip on phones. The home page has the
   compact carousel instead (partials/reviews-carousel.njk), which links here (#reviews). #}
{% set R = strings[lang].reviews %}
<section class="band--pale-blue reviews-band" id="reviews">
  <div class="wrap">
    <div class="reviews-head">
      <div>
        <p class="eyebrow eyebrow--blue">{{ R.eyebrow }}</p>
        <h2>{{ R.heading }}</h2>
        <p class="lede">{{ R.lede }}</p>
      </div>
      {% include "partials/rating.njk" %}
    </div>

    <ul class="reviews">
      {% for r in reviews.items | reviewsFor(lang) %}
      {% set q = r | pullQuote %}
      <li class="review">
        <span class="stars stars--small" style="--fill: 100%" role="img" aria-label="{{ R.stars }}"></span>
        <p class="review__pull" lang="{{ r.lang }}">“{% if q.pre %}…{% endif %}{{ q.text }}{% if q.post %}…{% endif %}”</p>
        <div class="review__text" lang="{{ r.lang }}">{% for p in r.paras %}<p>{{ p | markPull(r.pull) | safe }}</p>{% endfor %}</div>
        <button class="review__more" type="button" aria-expanded="false" data-less="{{ R.less }}" hidden>{{ R.more }}</button>
        <p class="review__who"><strong>{{ r.name }}</strong><span>{{ R.source }}</span></p>
      </li>
      {% endfor %}
    </ul>
    <p class="reviews__hint">{{ R.swipe }}</p>
  </div>
</section>
