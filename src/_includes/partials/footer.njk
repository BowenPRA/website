<footer class="site-footer">
  <div class="tape" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  {% set frondClass = "frond--br" %}{% include "partials/frond.njk" %}
  <div class="wrap site-footer__grid">
    <div>
      <img class="site-footer__logo" src="{{ '/assets/img/logo.png' | url }}" alt="{{ site.name }}" width="1064" height="429" loading="lazy">
      <p class="site-footer__tag">{{ site.tagline }}</p>
      <p class="site-footer__licence">{{ site.licenceLine }}</p>
      <div class="social">
        <a href="{{ site.social.facebook }}" rel="noopener" target="_blank" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"/></svg></a>
        <a href="{{ site.social.whatsapp }}" rel="noopener" target="_blank" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.1.6a2.7 2.7 0 0 0 1.8-1.2c.2-.6.2-1.1.2-1.2l-.5-.3z"/></svg></a>
      </div>
    </div>
    <div>
      <p class="site-footer__h">Find us</p>
      <p>{{ site.campus.address }}<br><a href="{{ site.campus.mapUrl }}" rel="noopener" target="_blank">Open in Google Maps</a></p>
      <p>{{ site.hours }}</p>
    </div>
    <div>
      <p class="site-footer__h">Talk to us</p>
      <p><a href="tel:{{ site.phoneIntl }}">{{ site.phone }}</a><br>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <ul class="site-footer__links">
        <li><a href="{{ '/contact/' | url }}">Book a tour</a></li>
        <li><a href="{{ '/admissions/' | url }}">Enrollment</a></li>
        <li><a href="{{ '/admissions/tuition-and-fees/' | url }}">Fees</a></li>
        <li><a href="{{ '/families/schedule/' | url }}">Schedule</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap site-footer__small">
    <span>© {{ '' | year }} {{ site.name }}. Serving families in Hội An and Đà Nẵng since {{ site.founded }}.</span>
    <span><a href="{{ '/families/handbook/' | url }}">Family handbook</a></span>
  </div>
</footer>
