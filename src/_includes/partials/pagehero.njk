{# Inner-page hero: the page tone as the band, the photo framed beside the text with a palm frond behind it.
   Set heroPhoto, heroEyebrow, heroTitle (may hold a <span class="mark">), heroText; optional heroShape (tall) for a portrait photo. #}
<section class="phero">
  <span class="phero__dots" aria-hidden="true"></span>
  {% set frondClass = "frond--tr frond--soft" %}{% include "partials/frond.njk" %}
  <div class="wrap phero__grid">
    <div class="phero__text">
      {% if heroEyebrow %}<p class="eyebrow eyebrow--on rise" style="--d:0">{{ heroEyebrow }}</p>{% endif %}
      <h1 class="rise" style="--d:1">{{ heroTitle | safe }}</h1>
      {% if heroText %}<p class="lede rise" style="--d:2">{{ heroText }}</p>{% endif %}
    </div>
    <div class="phero__media rise" style="--d:2">
      {% set frondClass = "" %}{% include "partials/frond.njk" %}
      {% photo heroPhoto, "phero__photo" + (" phero__photo--" + heroShape if heroShape else ""), "(min-width: 1240px) 520px, (min-width: 900px) 44vw, (min-width: 620px) 560px, 92vw", true %}
    </div>
  </div>
  {% include "partials/river.njk" %}
</section>
