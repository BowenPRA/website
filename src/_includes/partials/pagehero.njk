<section class="hero hero--inner{% if heroTone %} hero--{{ heroTone }}{% endif %}">
  <div class="hero__bg">{% photo heroPhoto, "", "100vw", true %}</div>
  <img class="leaf leaf--tr" src="{{ '/assets/img/leaf-a.webp' | url }}" alt="" width="900" height="910">
  <div class="wrap hero__inner">
    {% if heroEyebrow %}<p class="eyebrow eyebrow--white">{{ heroEyebrow }}</p>{% endif %}
    <h1>{{ heroTitle }}</h1>
    {% if heroText %}<p class="lede">{{ heroText }}</p>{% endif %}
  </div>
  {% set waveColor = heroWave or "white" %}{% include "partials/wave.njk" %}
</section>
