{# Small stroke icons. Use: {% import "macros/icons.njk" as ic %} {{ ic.icon("flask", "sun") }} #}
{% macro icon(name, tone) %}
<span class="icon{% if tone %} icon--{{ tone }}{% endif %}" aria-hidden="true">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "flask" -%}<path d="M9 3h6M10 3v6l-5.5 9A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7.5 15h9"/>
{%- elif name == "whisk" -%}<path d="M14 10l6-6"/><path d="M4 20l6-6"/><path d="M8.5 15.5c-2.5-2.5-2-6.5.5-9s6.5-3 9-.5-2 6.5-.5 9-6.5 3-9 .5z"/>
{%- elif name == "chat" -%}<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>
{%- elif name == "ball" -%}<circle cx="12" cy="12" r="9"/><path d="M3.5 9.5c3 1 6 1 8.5 2.5s4.5 4.5 5.5 8"/><path d="M6.5 19c1-3 3-5.5 6-6.5s6-1 8-.5"/>
{%- elif name == "book" -%}<path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
{%- elif name == "laptop" -%}<rect x="3" y="5" width="18" height="11" rx="2"/><path d="M2 19h20"/>
{%- elif name == "palette" -%}<path d="M12 3a9 9 0 1 0 0 18h1.5a2 2 0 0 0 1.5-3.3 2 2 0 0 1 1.5-3.2H19a3 3 0 0 0 3-3c0-4.7-4.5-8.5-10-8.5z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10.5" cy="7" r="1"/><circle cx="15" cy="7.5" r="1"/>
{%- elif name == "leaf" -%}<path d="M4 20c0-8 4-14 16-16-1 12-7 16-16 16z"/><path d="M4 20c4-5 8-8 12-10"/>
{%- elif name == "globe" -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/>
{%- elif name == "heart" -%}<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
{%- elif name == "star" -%}<path d="M12 3l2.7 5.6 6.3.9-4.5 4.4 1 6.1L12 17l-5.5 3 1-6.1L3 9.5l6.3-.9z"/>
{%- elif name == "ruler" -%}<path d="M3 17L17 3l4 4L7 21z"/><path d="M13 7l1.5 1.5M10 10l1.5 1.5M7 13l1.5 1.5"/>
{%- elif name == "tools" -%}<path d="M14.5 5.5a3.5 3.5 0 0 0 4 4l2.5 2.5-4 4-2.5-2.5a3.5 3.5 0 0 0-4-4L3 3l2.5-.5z"/><path d="M15 15l5 5"/>
{%- elif name == "clock" -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == "sun" -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
{%- elif name == "users" -%}<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 15.5a5 5 0 0 1 5.5 4.5"/>
{%- elif name == "sparkle" -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 17l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>
{%- else -%}<circle cx="12" cy="12" r="9"/>
{%- endif -%}
</svg>
</span>
{% endmacro %}
