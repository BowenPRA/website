<!doctype html>
{% set T = strings[lang] %}
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# `pageTitle` replaces the whole title; the home pages use it so a search for the name finds "Palm River Academy" first #}
  <title>{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  {# `metaDescription`, `ogTitle`, `ogType` and `ogImage` (with ogImageW/H/Alt) let a page set its own link preview;
     the newsletter issues do (src/newsletter/newsletter.11tydata.js). #}
  <meta name="description" content="{{ metaDescription or description or site.description }}">
  {# front matter `noindex: true` keeps a page out of search results — the album is ours, not the public's #}
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url | url }}">{% endif %}
  <meta name="theme-color" content="#116DFF">
  <meta property="og:title" content="{{ ogTitle or pageTitle or title or site.name }}">
  <meta property="og:description" content="{{ metaDescription or description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="{{ T.locale }}">
  {# Each page and its twin in the other language (VIETNAMESE.md). English is the default. #}
  {% if not noTwin %}
  {% set enUrl = page.url | basePath %}
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl | url }}">
  <link rel="alternate" hreflang="vi" href="{{ site.url }}{{ enUrl | twin | url }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ enUrl | url }}">
  {% endif %}
  {% if ogImage %}
  <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ ogImage }}">
  {% if ogImageW and ogImageH %}<meta property="og:image:width" content="{{ ogImageW }}">
  <meta property="og:image:height" content="{{ ogImageH }}">{% endif %}
  {% if ogImageAlt %}<meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}
  {% if ogPublished %}<meta property="article:published_time" content="{{ ogPublished }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  {% else %}
  <meta property="og:image" content="{{ site.url }}{{ '/assets/img/photos/hero-cooking-class-hoi-an-1600.webp' | href(lang) }}">
  {% endif %}
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | href(lang) }}" type="image/svg+xml">
  {# Poppins has no Vietnamese letters (ộ, ế, ở...). Vietnamese pages are set in Be Vietnam Pro; English pages
     list it after Poppins, and the browser fetches only its Vietnamese letters, for place names like Hội An.
     Both fonts are files on this site (scripts/fonts.mjs), so the text never waits on Google's servers.
     The body and heading weights are fetched first. #}
  {% set fontsFirst = ["be-vietnam-pro-400-latin", "be-vietnam-pro-700-latin", "be-vietnam-pro-400-vietnamese"] if lang == "vi" else ["poppins-400-latin", "poppins-700-latin"] %}
  {% for f in fontsFirst %}<link rel="preload" href="{{ ('/assets/fonts/' + f + '.woff2') | url }}" as="font" type="font/woff2" crossorigin>
  {% endfor %}<style>{% include "partials/fonts.njk" %}</style>
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | href(lang) }}">
  <script>document.documentElement.classList.add("js")</script>
  {# The center's details for Google, on the home page only. EducationalOrganization, never School (PRA is a language center). #}
  {% if page.url == "/" or page.url == "/vi/" %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": [{
    "@type": "WebSite",
    "name": site.name,
    "alternateName": site.shortName,
    "url": site.url + "/"
  }, {
    "@type": "EducationalOrganization",
    "name": site.name,
    "alternateName": site.shortName,
    "url": site.url + "/",
    "description": site.description,
    "email": site.email,
    "telephone": site.phoneIntl,
    "foundingDate": site.founded | string,
    "address": { "@type": "PostalAddress", "streetAddress": "Trần Nhân Tông, Cẩm Thanh", "addressLocality": "Hội An", "addressCountry": "VN" },
    "logo": site.url + "/assets/img/logo.png",
    "sameAs": [site.social.facebook]
  }] } | dump | safe }}</script>
  {% endif %}
</head>
{# The announcement reel under the nav bar (partials/header.njk). `has-reel` makes room for it above each hero. #}
{% set reelNow = reel.items | withNewsletter(newsletters, lang, strings) | current %}
<body class="page-{{ (page.fileSlug if page.fileSlug != 'vi') or 'home' }} tone-{{ tone or 'blue' }}{% if stage %} stage-{{ stage }}{% endif %}{% if reelNow.length %} has-reel{% endif %}">
  <a class="skip" href="#main">{{ T.skip }}</a>
  {% include "partials/frond-symbol.njk" %}
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <a class="float-cta" href="{{ '/contact/' | href(lang) }}" aria-label="{{ T.contact }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
  </a>
  <script src="{{ '/assets/js/main.js' | href(lang) }}" defer></script>
  {# A page that needs its own script names it in front matter: `script: "/assets/js/enroll.js"`. #}
  {% if script %}<script src="{{ script | href(lang) }}" defer></script>{% endif %}
  {# Visitor counts: Cloudflare Web Analytics, no cookies (dash.cloudflare.com, Analytics & Logs, Web Analytics).
     The token is in site.json; empty turns it off. Our own pages (noindex: the album, newsletter preview) are not counted. #}
  {% if site.analytics.cloudflareToken and not noindex %}<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.analytics.cloudflareToken }}"}'></script>{% endif %}
</body>
</html>
