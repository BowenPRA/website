---
layout: layouts/base.njk
tone: blue
title: "Academics"
description: "Early Years, Primary, Lower Secondary, Upper Secondary and the Global Program at Palm River Academy, side by side."
---

{% set heroPhoto = "primary-students-clay-modelling" %}
{% set heroEyebrow = "Academics" %}
{% set heroTitle = 'Five programs, one way of <span class="mark">working</span>' %}
{% set heroText = "Every age, the same idea: lessons in English, something physical, something made by hand." %}
{% include "partials/pagehero.njk" %}

<section data-picker>
  <div class="wrap">
    <p class="eyebrow eyebrow--sun">Start here</p>
    <h2>How old is your child?</h2>
    <p class="lede">Tap an age to see the right program.</p>
    <div class="picker__chips" role="group" aria-label="Filter programs by age">
      {% for p in programs %}<button class="chip chip--{{ p.tone }}" type="button" data-key="{{ p.key }}" aria-pressed="false">{{ p.chip }}</button>{% endfor %}
    </div>
    <div class="programs">
      {% for p in programs %}
      <article class="program program--{{ p.tone }}" data-key="{{ p.key }}">
        {% photo p.photo, "program__photo", "(min-width: 1240px) 380px, (min-width: 1024px) 31vw, (min-width: 720px) 46vw, 92vw" %}
        <p class="program__ages">{{ p.ages }}</p>
        <h3>{{ p.name }}</h3>
        <p>{{ p.summary }}</p>
        <ul>{% for pt in p.points %}<li>{{ pt }}</li>{% endfor %}</ul>
        <a class="btn btn--primary btn--small" href="{{ p.url | url }}">About {{ p.name }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% set waveColor = "pale" %}{% include "partials/wave.njk" %}
<section class="band--pale">
  <div class="wrap">
    <h2>Side by side</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Program</th><th>Ages</th><th>Curriculum</th><th>Day</th><th>Class size</th></tr></thead>
        <tbody>
          <tr><td>Early Years</td><td>20 months to 4</td><td>British EYFS, in English</td><td>8:00 to 15:30</td><td>Small groups, two teachers</td></tr>
          <tr><td>Primary</td><td>Years 1 to 6</td><td>Cambridge Primary + afternoon classes</td><td>8:00 to 15:15</td><td>{{ site.classCap }} or fewer</td></tr>
          <tr><td>Lower Secondary</td><td>Years 7 to 9</td><td>Cambridge Lower Secondary + afternoon classes</td><td>8:00 to 15:20</td><td>{{ site.classCap }} or fewer</td></tr>
          <tr><td>Upper Secondary</td><td>Ages 14 to 18</td><td>US diploma or Cambridge pathway, exam prep</td><td>8:00 to 15:20</td><td>{{ site.classCap }} or fewer</td></tr>
          <tr><td>Global Program</td><td>2 to 14</td><td>Joins the above for 3 weeks to 3 months</td><td>Half or full day</td><td>{{ site.classCap }} or fewer</td></tr>
        </tbody>
      </table>
    </div>
    <span class="swipe-hint">Swipe sideways to see the whole table.</span>
    <p class="form__note">Every group's full week is on the <a href="{{ '/families/schedule/' | url }}">schedule page</a>.</p>
  </div>
</section>

{% set waveColor = "blue" %}{% include "partials/wave.njk" %}
{% include "partials/cta.njk" %}
