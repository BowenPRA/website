<section>
  <div class="wrap two">
    <div>
      <p class="eyebrow">Every morning</p>
      <h2>English, Maths and Science</h2>
      <p>Three lessons before lunch, every day. <strong>English</strong> is real books, real writing and a lot of talking. <strong>Maths</strong> starts with objects and works up. <strong>Science</strong> is experiments first, explanations second.</p>
      <p>Cambridge Primary is recognised everywhere, so moving on later is easy.</p>
    </div>
    <div class="leaf-wrap leaf-wrap--r has-sticker">
      <span class="sticker sticker--green sticker--tr">Cambridge Primary</span>
      {% photo "primary-maths-roll-or-stack", "photo--lg photo--square photo--tilt-r" %}
    </div>
  </div>
</section>

{% set waveColor = "pale" %}{% include "partials/wave.njk" %}
