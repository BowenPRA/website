  <div class="wrap">
    <div class="center narrow">
      <p class="eyebrow">Monday to Friday</p>
      <h2>A Primary day</h2>
      <p class="lede">The core subjects while heads are fresh, the hands-on classes after lunch.</p>
    </div>
    <div class="mt">{% set dayKey = "primary" %}{% include "partials/dayline.njk" %}</div>
  </div>
</section>
{% set waveColor = "white" %}{% include "partials/wave.njk" %}

<section>
  <div class="wrap">
    <div class="center narrow">
      <p class="eyebrow eyebrow--blue">Every afternoon</p>
      <h2>The classes with the odd names</h2>
      <p class="lede">This year's afternoon classes. This is where the English gets used.</p>
    </div>
    <div class="cards cards--3 mt">
      <div class="card">{{ ic.icon("whisk", "sun") }}<h3>Cooking</h3><p>A real kitchen and a dish to take home.</p></div>
      <div class="card">{{ ic.icon("laptop", "blue") }}<h3>Technology</h3><p>Typing, coding, and making screens do what you tell them.</p></div>
      <div class="card">{{ ic.icon("palette", "coral") }}<h3>Craft and Art</h3><p>Lanterns, printing, clay, paint. Assessed by what gets made, not by a test.</p></div>
      <div class="card">{{ ic.icon("ball", "green") }}<h3>Movement and Dance</h3><p>Sport, fitness, dance and free play on the turf.</p></div>
      <div class="card">{{ ic.icon("book", "violet") }}<h3>Talk, puzzles and books</h3><p>Practice, Presentation and Play, Master Minds, Everyday Experts, Book Worms and Wellbeing: speaking up, puzzles, know-how and reading.</p></div>
      <div class="card">{{ ic.icon("clock", "blue") }}<h3>Boredom</h3><p>No screens, no instructions. Just time to think something up.</p></div>
    </div>
    <p class="center mt"><a class="btn btn--primary" href="{{ '/families/schedule/#primary' | url }}">See the week at a glance</a></p>
  </div>
</section>

