---
layout: layouts/base.njk
tone: blue
title: "Book a tour"
description: "Book a tour of Palm River Academy in Hội An, or ask a question. Phone, email and the campus address."
---

{% set heroPhoto = site.campus.photo %}
{% set heroEyebrow = "Contact us" %}
{% set heroTitle = 'Come and have <span class="mark">a look</span>' %}
{% set heroText = "Tours take about an hour on a school day. Not in Hội An yet? We will do a video call instead. Or just ask a question, we answer those too." %}
{% include "partials/pagehero.njk" %}

<section>
  <div class="wrap two two--top">
    <form class="form" action="{{ site.formAction }}" method="POST">
      <div class="form__row">
        <div><label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" required></div>
        <div><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required></div>
      </div>
      <div class="form__row">
        <div><label for="phone">Phone, Zalo or WhatsApp</label><input id="phone" name="phone" type="tel" autocomplete="tel"></div>
        <div><label for="age">Your child's age</label>
          <select id="age" name="child_age">
            <option value="">Choose one</option>
            <option>Under 2</option><option>2 to 4</option><option>5 to 7</option><option>8 to 11</option><option>11 to 14</option><option>14 to 18</option>
          </select>
        </div>
      </div>
      <div><label for="want">What would you like?</label>
        <select id="want" name="want">
          <option>A campus tour</option>
          <option>A video call</option>
          <option>Information about the Global Program</option>
          <option>Just a question</option>
        </select>
      </div>
      <div><label for="msg">Anything we should know</label><textarea id="msg" name="message" placeholder="Dates you are in Hội An, your child's English, what they love doing..."></textarea></div>
      <input type="hidden" name="_subject" value="Website inquiry">
      {% if "REPLACE_ME" in site.formAction %}
      <button class="btn btn--green" type="submit" disabled>Send</button>
      <p class="form__note">We are still connecting this form. Until then, email <a href="mailto:{{ site.email }}">{{ site.email }}</a> or message us on <a href="{{ site.social.whatsapp }}" rel="noopener" target="_blank">WhatsApp</a>.</p>
      {% else %}
      <button class="btn btn--green" type="submit">Send</button>
      {% endif %}
    </form>
    <div>
      <div class="card" style="margin-bottom:18px">
        <h3>Talk to a person</h3>
        <p><a href="tel:{{ site.phoneIntl }}">{{ site.phone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>{{ site.hours }}</p>
        <p><a href="{{ site.social.whatsapp }}" rel="noopener" target="_blank">WhatsApp</a> · <a href="{{ site.social.facebook }}" rel="noopener" target="_blank">Facebook</a></p>
      </div>
      <div class="card">
        {% photo "campus-playground-collage", "", "(min-width: 900px) 40vw, 100vw" %}
        <h3>Find us</h3>
        <p>{{ site.campus.address }}</p>
        <a href="{{ site.campus.mapUrl }}" rel="noopener" target="_blank">Open in Google Maps</a>
      </div>
    </div>
  </div>
</section>
