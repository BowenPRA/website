{# Twin of src/events.njk; see the notes there. #}
{% set heroPhoto = "events-hero-maths-prize-stickers" %}
{% set heroShape = "tall" %}
{% set heroEyebrow = "Sự kiện" %}
{% set heroTitle = 'Sự kiện do chính <span class="mark">học viên tổ chức</span>' %}
{% set heroText = "Lễ hội, tuần lễ chủ đề và các chuyến đi. Ở mỗi sự kiện, học viên đều có phần việc của mình: biểu diễn, dẫn chương trình, phụ trách gian hàng hoặc hướng dẫn hoạt động cho các lớp nhỏ hơn. Sự kiện của năm học này được cập nhật sau khi diễn ra, sự kiện mới nhất ở trên cùng." %}
{% include "partials/pagehero.njk" %}

<section>
  <div class="wrap">
    <p class="gallery__hint events__hint" hidden>Chạm vào ảnh để phóng to.</p>
    {% set sy = eventYears.current %}{% set evNewest = true %}
    {% set evTitle = "Năm học " + sy + " <span>Năm học này</span>" %}
    {% set evMonths = "Chọn tháng" %}{% set evDid = "Phần việc của học viên" %}{% set evMore = "Xem toàn bộ" %}
    {% include "partials/events-year.njk" %}
  </div>
</section>

{% set waveColor = "pale" %}{% include "partials/wave.njk" %}
<section class="band--pale">
  <div class="wrap center narrow">
    <p class="eyebrow eyebrow--blue">Năm học trước</p>
    <h2>Sự kiện năm học {{ eventYears.past[0] }}</h2>
    <p class="lede">Trung thu, Giáng sinh, Tết, March Mathness, lễ tốt nghiệp và nhiều sự kiện khác, cùng phần việc của học viên trong từng sự kiện.</p>
    <p class="event-page__links">
      {% for y in eventYears.past %}<a class="btn {{ 'btn--primary' if loop.first else 'btn--ghost' }}" href="{{ ('/events/' + y + '/') | href(lang) }}">Sự kiện năm học {{ y }}</a>{% endfor %}
    </p>
  </div>
</section>
{% set waveColor = "white" %}{% include "partials/wave.njk" %}

<section>
  <div class="wrap center narrow">
    <p class="eyebrow eyebrow--blue">Năm học này</p>
    <h2>Lịch năm học {{ eventYears.current }}</h2>
    <p class="lede">Thời gian học và các kỳ nghỉ đều có trong lịch năm học. Ngày tổ chức từng sự kiện sẽ được PRA thông báo đến các gia đình trong năm.</p>
    <a class="btn btn--primary" href="{{ '/families/schedule/#calendar' | href(lang) }}">Xem lịch năm học</a>
  </div>
</section>

{% set waveColor = "blue" %}{% include "partials/wave.njk" %}
